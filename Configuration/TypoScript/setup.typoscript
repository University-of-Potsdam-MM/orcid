plugin.tx_orcid {
    view {
        templateRootPaths {
            0 = EXT:orcid/Resources/Private/Templates/
            10 = {$plugin.tx_orcid.view.templateRootPath}
        }
        partialRootPaths {
            0 = EXT:orcid/Resources/Private/Partials/
            1 = EXT:fluid_styled_content/Resources/Private/Partials/
            10 = {$plugin.tx_orcid.view.partialRootPath}
        }
        layoutRootPaths {
            0 = EXT:orcid/Resources/Private/Layouts/
            10 = {$plugin.tx_orcid.view.layoutRootPath}
        }
    }
}
