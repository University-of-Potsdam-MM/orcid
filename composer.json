{
    "name": "unipotsdam/orcid",
    "description": "Fetch and display ORCID work data in TYPO3 CMS",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "authors": [
        {
            "name": "Universität Potsdam"
        },
        {
            "name": "queonext"
        }
    ],
    "require": {
        "ext-curl": "*",
        "typo3/cms-core": "*",
        "typo3/cms-fluid-styled-content": "*"
    },
    "autoload": {
        "psr-4": {
            "UniPotsdam\\Orcid\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "orcid"
        }
    },
    "version": "13.0.0"
}
